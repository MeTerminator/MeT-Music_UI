{
  "name": "@met/app",
  "version": "7.2.2",
  "private": true,
  "description": "MeT-Music React SPA(web 版与 Electron renderer 共用)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-nac-assets.mjs && vite dev",
    "build": "node scripts/prepare-nac-assets.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "node scripts/prepare-nac-assets.mjs && vitest run --config vitest.config.ts",
    "e2e:nac:production": "pnpm build && playwright test --config playwright.nac-production.config.ts"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.6.0",
    "@applemusic-like-lyrics/react": "^0.6.0",
    "@base-ui/react": "^1.9.0",
    "@material/material-color-utilities": "^0.4.0",
    "@met/core": "workspace:*",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@wasm-audio-decoders/flac": "0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "colorthief": "^3.5.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "mp4box": "2.5.0",
    "onnxruntime-web": "1.31.1",
    "plyr": "^3.8.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
